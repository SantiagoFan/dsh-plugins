{
  "name": "@mindlink-ai/dsh-todo-workbench",
  "version": "2.0.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Personal todo workbench: manage tasks in a DSH sidebar panel with categories, priority, due dates, notes, and tags, and record todos from the conversation into the same list.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "todo",
    "tasks",
    "checklist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantiagoFan/dsh-plugins.git",
    "directory": "packages/todo-workbench"
  },
  "homepage": "https://github.com/SantiagoFan/dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/SantiagoFan/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/store.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "test/store.mjs",
    "test/host.mjs",
    "test/client-render.mjs"
  ],
  "scripts": {
    "test": "node test/store.mjs && node test/host.mjs && node test/client-render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "author": "思链科技（MindLink）"
}
